# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，切勿提交。

# ---- 运行模式 ----
DRY_RUN=true
LOG_LEVEL=INFO

# ---- 交易标的 ----
# 套利关注的币种对，逗号分隔
TRADE_SYMBOLS=BTC/USDT,ETH/USDT

# ---- 风险控制 ----
MAX_POSITION_USDT=100
MIN_SPREAD_PCT=0.1

# ---- 交易所 A：Binance ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- 交易所 B：OKX ----
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ---- 交易所 C：Bybit ----
BYBIT_API_KEY=
BYBIT_API_SECRET=
